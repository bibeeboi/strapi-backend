{
  "kind": "collectionType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Setting"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string"
    },
    "siteSubtitle": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "address": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "instagramUrl": {
      "type": "string"
    },
    "youtubeUrl": {
      "type": "string"
    },
    "tiktokUrl": {
      "type": "string"
    },
    "logoUrl": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "phone": {
      "type": "string"
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::organization.organization",
      "inversedBy": "site_settings"
    }
  }
}
